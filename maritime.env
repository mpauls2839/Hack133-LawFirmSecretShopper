# Maritime env for a dedicated front-door / intake-grader agent.
#   maritime env import intake-frontdoor ./maritime.env --reload
# Do not commit secrets.
#
# Maritime injects OPENAI_BASE_URL + OPENAI_API_KEY (mllm_…) — do not set them here.
# After create, replace ROUTER_PUBLIC_URL with the real https://api.maritime.sh/a/<id>

PORT=3000
DB_PATH=/app/data/intake-grader.db
ROUTER_PUBLIC_URL=https://api.maritime.sh/a/REPLACE_WITH_AGENT_ID
PUBLIC_BASE_URL=https://api.maritime.sh/a/REPLACE_WITH_AGENT_ID

ALLOW_LIVE_SENDS=false
DEFAULT_CHANNEL_DRIVER=mock

JUDGE_FAST_MODEL=gpt-4o-mini
JUDGE_DEEP_MODEL=gpt-5
FRONTDOOR_MODEL=gpt-4o-mini

GHL_PRIVATE_TOKEN=pit-ead24e92-79f1-4b87-a778-0a9fe468aea5
GHL_LOCATION_ID=jC52WuYhSqW0DhSRzG3j
GHL_FROM_NUMBER=+17407614801

FAST_CLOCK=false
