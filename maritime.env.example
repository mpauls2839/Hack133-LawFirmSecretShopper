# Copy to maritime.env, fill secrets, then:
#   maritime env import secret-shopper-app ./maritime.env --reload
# Do not commit maritime.env
#
# Important:
# - PORT must match --port from create (3000). Maritime may inject 18789; override it.
# - DATA_DIR must be /app/data (not /data). Maritime's /data volume is often unwritable.
# - Do NOT set OPENAI_API_KEY or OPENAI_BASE_URL here — Maritime injects its LLM proxy.
# - Do NOT set LLM_API_KEY — the app uses the injected OPENAI_API_KEY.

PUBLIC_BASE_URL=https://api.maritime.sh/a/REPLACE_WITH_AGENT_ID
PORT=3000
DATA_DIR=/app/data
REPLY_DELAY_SECONDS=45
CONVERSATION_TTL_HOURS=12

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

START_CONVERSATION_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET

GHL_PRIVATE_TOKEN=REPLACE
GHL_LOCATION_ID=REPLACE
GHL_FROM_NUMBER=+17407614801
GHL_VALIDATE_SIGNATURE=false

QSTASH_TOKEN=REPLACE
QSTASH_CURRENT_SIGNING_KEY=REPLACE
QSTASH_NEXT_SIGNING_KEY=REPLACE
QSTASH_VALIDATE_SIGNATURE=true
