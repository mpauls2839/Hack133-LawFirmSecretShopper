############################################################
# Intake Grader — copy to .env and fill secrets.
#
# What you actually need (by mode):
#
#   mock / unit tests     → nothing. Defaults work.
#   front-door browser    → one LLM key (OPENAI_API_KEY), or run inside Maritime
#                           which injects OPENAI_BASE_URL + OPENAI_API_KEY for you.
#   live SMS via GHL      → GHL_PIT (or GHL_PRIVATE_TOKEN), GHL_LOCATION_ID,
#                           GHL_FROM_NUMBER + ALLOW_LIVE_SENDS=true + allowlist.
#
# Dropped / unused on this branch: QStash, LLM_PROVIDER, DATA_DIR, START_CONVERSATION_TOKEN.
############################################################

# ---- router ----------------------------------------------
PORT=3000
DB_PATH=./data/intake-grader.db
# Public HTTPS URL of this router (webhooks). Alias: PUBLIC_BASE_URL
ROUTER_PUBLIC_URL=

# ---- safety / channel ------------------------------------
ALLOW_LIVE_SENDS=false
# mock | ghl
DEFAULT_CHANNEL_DRIVER=mock

# ---- LLM (one key) ---------------------------------------
# Prefer OPENAI_API_KEY. Inside a Maritime agent it is injected automatically
# (mllm_…). Locally: set an OpenAI key, or leave blank to use the offline stub
# (judge + front-door will not call a model).
OPENAI_API_KEY=
# Optional; Maritime injects OPENAI_BASE_URL. Local OpenAI default:
# OPENAI_BASE_URL=https://api.openai.com/v1
JUDGE_FAST_MODEL=gpt-4o-mini
JUDGE_DEEP_MODEL=gpt-5
# Front-door reuses the same key; model override optional:
FRONTDOOR_MODEL=gpt-4o-mini

# ---- GoHighLevel (only for live SMS) ---------------------
# Alias: GHL_PRIVATE_TOKEN is accepted if GHL_PIT is empty.
GHL_PIT=
GHL_LOCATION_ID=
GHL_FROM_NUMBER=+17407614801
# Front-door inbound number defaults to GHL_FROM_NUMBER when unset.
# FRONTDOOR_INBOUND_NUMBER=+17407614801

# ---- demos -----------------------------------------------
# Collapse reply delays so a full mock run finishes in seconds.
FAST_CLOCK=false
