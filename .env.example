############################################################
# Intake Grader — copy to .env and fill in. Nothing here is
# required to run the mock loop or the tests.
############################################################

# ---- router ----------------------------------------------
PORT=3000
DB_PATH=./data/intake-grader.db
# Public URL of this router, needed only for inbound webhooks.
ROUTER_PUBLIC_URL=

# ---- safety gates ----------------------------------------
# Master switch. While false, no message can leave this machine,
# whatever else is configured. Live sending also requires the
# target domain to be listed in config/allowlist.txt.
ALLOW_LIVE_SENDS=false
# mock | maritime | ghl
DEFAULT_CHANNEL_DRIVER=mock
# Local development reads a file. Deployed containers have no file to mount, so name the
# permitted domains here instead — comma or space separated. Both sources are unioned,
# and an empty allowlist means no target can be contacted at all.
TARGET_ALLOWLIST=./config/allowlist.txt
TARGET_ALLOWLIST_DOMAINS=

# ---- judge (OpenAI-compatible) ---------------------------
# Inside a Maritime agent the platform injects OPENAI_BASE_URL and OPENAI_API_KEY
# (mllm_…) and those win, so nothing here needs setting for a deployed router.
MARITIME_LLM_BASE=https://api.maritime.sh/api/llm/v1
# Used for the Maritime CLI. NOT usable as an LLM bearer token: the proxy rejects an
# mk_ control-plane key with a 401 that reads like a bad key.
MARITIME_TOKEN=
# auto = HTTP when a usable key exists, offline stub otherwise. Force with http | stub.
JUDGE_DRIVER=auto
# Chosen by measuring latency and sender-type accuracy together on real cases from a live
# run: gpt-5.4 was the fastest of seven tried and correct on all of them, while the larger
# models were 2-3x slower for the same answers and the nano tier called a blunt human reply
# a bot. Calibration with these: 95% on the 20-case fixture, against 85% on the stub.
JUDGE_FAST_MODEL=gpt-5.4
# Deep tier writes the narrative once per run at close, so nothing waits on it.
JUDGE_DEEP_MODEL=gpt-5.5
LLM_TIMEOUT_MS=30000
# Running against a provider directly instead of the Maritime proxy. Model ids are
# unprefixed here; the "openai/" prefix is Maritime's naming, and sending it to the
# provider is a 404.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=

# ---- Maritime agents -------------------------------------
MARITIME_CLI=maritime
MARITIME_PERSONA_TEMPLATE=openclaw_identity

# ---- GoHighLevel -----------------------------------------
GHL_PIT=
GHL_API_BASE=https://services.leadconnectorhq.com
# Confirm per endpoint group, they differ.
GHL_API_VERSION=2021-07-28
GHL_LOCATION_ID=
GHL_POLL_MS=30000

# ---- loop timing -----------------------------------------
MAX_TURNS=12
WALL_CLOCK_HOURS=72
REPLY_DELAY_MIN_MS=120000
REPLY_DELAY_MAX_MS=300000
NUDGE_AFTER_BIZ_MINUTES=240
MAX_NUDGES=2
NO_RESPONSE_CUTOFF_BIZ_MINUTES=1440
SWEEP_MS=60000

# Collapses every wait to zero so a full run finishes in seconds.
# Use for demos and tests only.
FAST_CLOCK=false
