# Public base URL of this service (must match GHL/QStash webhook URLs)
# Local: ngrok HTTPS URL. Maritime: the agent public HTTPS URL from `maritime info`.
PUBLIC_BASE_URL=https://your-public-url.example.com

# Server
PORT=3000
# Local: ./data. Maritime Docker: /app/data (avoid /data — platform volume may be unwritable)
DATA_DIR=./data
REPLY_DELAY_SECONDS=45
CONVERSATION_TTL_HOURS=12

# Shared secret for POST /conversations/start (header: x-start-token)
START_CONVERSATION_TOKEN=change-me-to-a-long-random-secret

# GoHighLevel (Twilio SMS is managed inside GHL)
# Create a Private Integration on the sub-account with scopes:
#   contacts.write, conversations/message.write, conversations.readonly
GHL_PRIVATE_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Optional if your token can resolve a single location via /locations/search
# Find it in the GHL URL: /v2/location/<LOCATION_ID>/...
GHL_LOCATION_ID=
GHL_FROM_NUMBER=+15551234567
# Workflow Custom Webhooks are unsigned — use false when wiring Customer Replied → Custom Webhook.
# Keep true only for marketplace InboundMessage subscriptions (Ed25519 / X-GHL-Signature).
GHL_VALIDATE_SIGNATURE=false

# QStash (Upstash) — durable wake-ups for processing, delayed send, and expiry
QSTASH_TOKEN=your_qstash_token
QSTASH_CURRENT_SIGNING_KEY=sig_xxxxxxxx
QSTASH_NEXT_SIGNING_KEY=sig_yyyyyyyy
# Set to "false" only for local unsigned job testing
QSTASH_VALIDATE_SIGNATURE=true

# LLM (OpenAI-compatible; Maritime injects OPENAI_BASE_URL + OPENAI_API_KEY)
# Supported: stub | openai
# Local without a key: stub. Maritime / production: openai + gpt-4o (uses proxy).
LLM_PROVIDER=stub
LLM_MODEL=gpt-4o
# Optional overrides (Maritime sets these automatically):
# LLM_BASE_URL=https://api.maritime.sh/api/llm/v1
# OPENAI_API_KEY=
# LLM_API_KEY=
